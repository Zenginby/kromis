# ÇAPALI (`/` ile): çapasız `output/` her derinlikte eşleşiyordu ve
# tests/fixtures/v18/output/history.json'ı da yutuyordu — testler yerelde
# yeşil, CI'da dosyalar HİÇ YOK oluyordu. Kastedilen zaten repo kökündeki
# kullanıcı verisi; bu adda başka iç dizin yok.
/output/
/assets/
.venv/
__pycache__/
*.pyc
.env
.DS_Store
# Dev'de data_dir() == REPO_DIR: gerçek uygulamayı repodan çalıştırmak
# bunları repo köküne yazar (bkz. paths.py).
.logos-seeded
.last-version
backups/
hata.log
build/
dist/

# graphify generated artifacts
graphify-out/
.superpowers/

# Claude Code tool directory (not project content)
.claude/

# Tasarım aracı artıkları (oturuma özel, proje içeriği değil)
.impeccable/
.playwright-mcp/

# ── Android ──────────────────────────────────────────────────────────
# `android/` dizininin KENDİSİ kaynak ve izleniyor; burada yalnız Gradle'ın
# ürettiği çıktılar ve makineye özel dosyalar var.
#
# DİKKAT — `android/wheels/*.whl` BİLEREK dışarıda BIRAKILMADI: pydantic-core
# wheel'ini biz derleyip repoya işliyoruz (bkz. docs/android/pydantic-karari.md).
# O dosya bir derleme çıktısı değil, Chaquopy'nin kurabildiği TEK kaynak.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.cxx/
*.apk
*.aab
# İmzalama anahtarı repoya ASLA girmemeli: APK'nın kimliğini o dosya taşıyor
# ve sızması, bizim adımıza imzalanmış sahte bir paket üretilmesi demek.
*.keystore
*.jks
