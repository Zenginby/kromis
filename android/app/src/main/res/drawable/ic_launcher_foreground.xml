<?xml version="1.0" encoding="utf-8"?>
<!-- Uyarlanabilir simgenin ön katmanı: Lumeo diyafram işareti
     (branding/lumeo-mark.svg ile aynı geometri, 108×108 güvenli alana
     ölçeklendi). 108×108 tuval, güvenli alan ortadaki 72×72 — kenarlar
     cihazın maskesine göre kırpılıyor, bu yüzden çizim merkeze toplandı.

     PNG DEĞİL, vektör: minSdk 26 olduğu için tüm cihazlar uyarlanabilir simgeyi
     destekliyor, yani beş ayrı yoğunlukta PNG üretmeye gerek yok. Bir vektör
     dosyası hem repoda okunabilir hem her ekranda keskin.

     Her yaprak ayrı bir <group> rotation'ıyla döndürülüyor (VectorDrawable
     path'leri SVG transform almaz); elips M-A-A-Z ile iki yarım ay çizilerek
     taklit ediliyor. android:monochrome de bu dosyayı kullanıyor (bkz.
     ic_launcher.xml) — Android o modda alfa maskesini kullanır, rengi
     kendi teması ile değiştirir. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.95" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.6" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.95" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.6" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.95" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path android:pathData="M54,26 A5.6,14 0 0 1 54,54 A5.6,14 0 0 1 54,26 Z"
            android:fillColor="#B48DF4" android:fillAlpha="0.6" />
    </group>

    <!-- Diyafram açıklığı -->
    <path
        android:pathData="M54,50.4 A3.6,3.6 0 0 1 54,57.6 A3.6,3.6 0 0 1 54,50.4 Z"
        android:strokeColor="#B48DF4"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.95"
        android:fillColor="#00000000" />
</vector>
