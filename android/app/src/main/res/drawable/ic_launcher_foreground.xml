<?xml version="1.0" encoding="utf-8"?>
<!-- Uyarlanabilir simgenin ön katmanı. 108×108 tuval, güvenli alan ortadaki
     72×72 — kenarlar cihazın maskesine göre kırpılıyor, bu yüzden çizim
     merkeze toplandı.

     PNG DEĞİL, vektör: minSdk 26 olduğu için tüm cihazlar uyarlanabilir simgeyi
     destekliyor, yani beş ayrı yoğunlukta PNG üretmeye gerek yok. Bir vektör
     dosyası hem repoda okunabilir hem her ekranda keskin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Kadraj çerçevesi -->
    <path
        android:pathData="M36,36 h36 a6,6 0 0 1 6,6 v24 a6,6 0 0 1 -6,6 h-36 a6,6 0 0 1 -6,-6 v-24 a6,6 0 0 1 6,-6 z"
        android:strokeColor="#E8EAED"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <!-- Ufuk çizgisi + tepe: "üretilmiş görsel" imgesi -->
    <path
        android:pathData="M34,68 L46,54 L56,64 L66,52 L74,62"
        android:strokeColor="#E8EAED"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Kıvılcım: üretimin yapay zeka tarafı -->
    <path
        android:pathData="M64,40 l2,4 4,2 -4,2 -2,4 -2,-4 -4,-2 4,-2 z"
        android:fillColor="#E8EAED" />
</vector>
